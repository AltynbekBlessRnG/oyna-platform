# API
PORT=4000
DATABASE_URL=postgresql://oyna:oyna@localhost:5432/oyna
AUTH_SECRET=replace-with-at-least-32-random-characters
# Канал доставки кода входа: console | mobizon | smsc
# Без ключей оператора сервис остаётся на console, и код виден только в логах.
OTP_PROVIDER=console
SMS_SENDER=OYNA
MOBIZON_API_KEY=
SMSC_LOGIN=
SMSC_PASSWORD=
# Запасной ключ кабинета: даёт права владельца платформы всем клубам.
# Основной вход в кабинет — по телефону администратора клуба (роль club_admin).
# В production ключ работает, только если задан здесь явно; в dev по умолчанию pilot-admin.
CLUB_ADMIN_KEY=replace-with-a-private-pilot-key

# Dashboard server-side connection
API_URL=http://localhost:4000/api

# Mobile: replace with the computer LAN IP when testing on a phone
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api

# Future club provider: manual | senet | smartshell | langame
CLUB_PROVIDER=manual
SENET_API_URL=
SENET_API_TOKEN=

# Steam OpenID and public profile analytics
STEAM_RETURN_URL=http://localhost:4000/api/integrations/steam/callback
STEAM_WEB_API_KEY=
