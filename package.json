{
  "name": "oyna-platform",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:mobile": "pnpm --filter @oyna/mobile dev",
    "dev:dashboard": "pnpm --filter @oyna/dashboard dev",
    "dev:api": "pnpm --filter @oyna/api dev",
    "db:up": "docker compose up -d postgres",
    "db:seed": "pnpm --filter @oyna/api seed",
    "db:down": "docker compose down",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
